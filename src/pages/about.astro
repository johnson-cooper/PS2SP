---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProjects, getSite } from "../lib/catalog";
import { getResources } from "../lib/resources";

const entry = await getSite();
const projects = await getProjects();
const resources = getResources();
const { Content } = await render(entry);
---

<BaseLayout title="About">
  <header class="page-hero compact">
    <div>
      <p class="eyebrow">About the plaza</p>
      <h1>{entry.data.longTitle}</h1>
      <p class="lead">{entry.data.description}</p>
    </div>
  </header>

  <div class="about-layout">
    <article class="prose project-prose">
      <Content />
      <section class="credits-panel" aria-labelledby="credits-heading" data-no-link-report>
        <p class="eyebrow">Project credits</p>
        <h2 id="credits-heading">People behind PS2SP</h2>
        <div class="credits-grid">
          <a class="credit-card" href="https://github.com/johnson-cooper" target="_blank" rel="noopener noreferrer">
            <span class="ps2-symbol credit-symbol" aria-hidden="true">△</span>
            <span><strong>johnson-cooper</strong><small>Repository owner</small></span>
            <span class="row-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="credit-card" href="https://github.com/NathanNeurotic" target="_blank" rel="noopener noreferrer">
            <span class="ps2-symbol credit-symbol" aria-hidden="true">□</span>
            <span><strong>NathanNeurotic</strong><small>Direction &amp; curation</small></span>
            <span class="row-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </article>
    <aside class="about-aside">
      <div><strong>{projects.length}</strong><span>software projects</span></div>
      <div><strong>{resources.length}</strong><span>ecosystem resources</span></div>
      <p>PS2SP separates structured software records from wider ecosystem links so a source repository, archive, forum, hardware guide and Discord community can all be indexed without pretending they are the same kind of thing.</p>
    </aside>
  </div>
</BaseLayout>
