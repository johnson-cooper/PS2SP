---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectDirectory from "../../components/ProjectDirectory.astro";
import { categoryLabel } from "../../lib/catalog";
import { getSoftwareCatalog } from "../../lib/software";

export async function getStaticPaths() {
  const software = await getSoftwareCatalog();
  const categories = [...new Set(software.flatMap((entry) => entry.categories))];
  return categories.map((category) => ({
    params: { category },
    props: { category, entries: software.filter((entry) => entry.categories.includes(category)) }
  }));
}

const { category, entries } = Astro.props;
---

<BaseLayout title={categoryLabel(category)}>
  <header class="page-hero compact">
    <div>
      <p class="eyebrow">Software category</p>
      <h1>{categoryLabel(category)}</h1>
      <p class="lead">Browse every indexed PS2SP software entry tagged in this category.</p>
    </div>
    <div class="page-count"><strong>{entries.length}</strong><span>{entries.length === 1 ? "entry" : "entries"}</span></div>
  </header>

  <ProjectDirectory entries={entries} showCategoryFilter={false} />
</BaseLayout>
