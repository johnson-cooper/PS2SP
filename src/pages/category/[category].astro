---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectDirectory from "../../components/ProjectDirectory.astro";
import { categoryLabel, getProjects } from "../../lib/catalog";

export async function getStaticPaths() {
  const projects = await getProjects();
  const categories = [...new Set(projects.flatMap((project) => project.data.categories))];
  return categories.map((category) => ({
    params: { category },
    props: { category, projects: projects.filter((project) => project.data.categories.includes(category)) }
  }));
}

const { category, projects } = Astro.props;
---

<BaseLayout title={categoryLabel(category)}>
  <header class="page-hero compact">
    <div>
      <p class="eyebrow">Software category</p>
      <h1>{categoryLabel(category)}</h1>
      <p class="lead">Browse every indexed PS2SP software entry tagged in this category.</p>
    </div>
    <div class="page-count"><strong>{projects.length}</strong><span>{projects.length === 1 ? "project" : "projects"}</span></div>
  </header>

  <ProjectDirectory projects={projects} showCategoryFilter={false} />
</BaseLayout>
