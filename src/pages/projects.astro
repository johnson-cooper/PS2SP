---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectDirectory from "../components/ProjectDirectory.astro";
import { getSoftwareCatalog } from "../lib/software";

const software = await getSoftwareCatalog();
---

<BaseLayout title="Software">
  <header class="page-hero compact">
    <div>
      <p class="eyebrow">Software registry</p>
      <h1>Software index</h1>
      <p class="lead">A dense, searchable registry of PS2 homebrew, games, ports, loaders, launchers, tools, SDKs, emulators and related software. Tracked projects include rich repository metadata; legacy and externally hosted software remains searchable even when no Git repository exists.</p>
    </div>
    <div class="page-count"><strong>{software.length}</strong><span>indexed</span></div>
  </header>

  <ProjectDirectory entries={software} />
</BaseLayout>
