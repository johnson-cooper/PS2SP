---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectDirectory from "../components/ProjectDirectory.astro";
import { getProjects } from "../lib/catalog";

const projects = await getProjects();
---

<BaseLayout title="Software">
  <header class="page-hero compact">
    <div>
      <p class="eyebrow">Software registry</p>
      <h1>Software index</h1>
      <p class="lead">A dense, searchable registry of PS2 homebrew, loaders, launchers, tools, SDKs, ports, emulators and related software. Quiet does not mean abandoned; source state is reported separately from editorial status.</p>
    </div>
    <div class="page-count"><strong>{projects.length}</strong><span>indexed</span></div>
  </header>

  <ProjectDirectory projects={projects} />
</BaseLayout>
