---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReportBrokenLink from "../components/ReportBrokenLink.astro";
import { categoryLabel, formatDate, getProjects, projectUpdatedAt } from "../lib/catalog";

function projectSourceUrl(project: Awaited<ReturnType<typeof getProjects>>[number]) {
  if (project.data.source.provider === "github" && project.data.source.repository) {
    return `https://github.com/${project.data.source.repository}`;
  }
  return project.data.source.url ?? project.data.homepage ?? `/project/${project.data.slug}`;
}

const projects = (await getProjects()).sort((a, b) =>
  new Date(projectUpdatedAt(b)).getTime() - new Date(projectUpdatedAt(a)).getTime()
);
---

<BaseLayout title="Recent updates">
  <header class="page-hero compact">
    <div>
      <p class="eyebrow">Upstream pulse</p>
      <h1>Recent activity</h1>
      <p class="lead">A chronological view of upstream releases and repository activity. Inactivity is not interpreted as abandonment.</p>
    </div>
    <div class="page-count"><strong>{projects.length}</strong><span>tracked</span></div>
  </header>

  <section class="timeline-shell">
    <div class="timeline-head">
      <span>Date</span>
      <span>Project</span>
      <span>Event</span>
      <span>Type</span>
    </div>
    <div class="timeline">
      {projects.map((project) => {
        const date = projectUpdatedAt(project);
        return (
          <div class="timeline-item">
            <a class="timeline-row" href={`/project/${project.data.slug}`}>
              <time datetime={date}>{formatDate(date)}</time>
              <span class="timeline-project">
                <strong>{project.data.name}</strong>
                <small>{project.data.summary}</small>
              </span>
              <span class="timeline-event">
                {project.data.latestRelease.tag ? `Release ${project.data.latestRelease.tag}` : "Repository activity"}
              </span>
              <span class="timeline-type">
                {categoryLabel(project.data.categories[0] ?? "uncategorized")}
                <span class="row-arrow" aria-hidden="true">↗</span>
              </span>
            </a>
            <ReportBrokenLink
              label={project.data.name}
              url={projectSourceUrl(project)}
              context="Recent activity listing"
              pageUrl="/updates"
              compact
            />
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
