---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportBrokenLink from "../../components/ReportBrokenLink.astro";
import { categoryLabel, formatDate, getProjects, projectUpdatedAt } from "../../lib/catalog";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const sourceUrl = project.data.source.provider === "github" && project.data.source.repository
  ? `https://github.com/${project.data.source.repository}`
  : project.data.source.url;
const updatedAt = projectUpdatedAt(project);
---

<BaseLayout title={project.data.name} description={project.data.summary}>
  <div class="breadcrumbs">
    <a href="/projects">Software</a>
    <span>/</span>
    <span>{project.data.name}</span>
  </div>

  <header class="project-hero">
    <div class="project-hero-copy">
      <div class="project-kicker">
        <span class="status-chip" data-state={project.data.repository.archived ? "archived" : "tracked"}>
          <i></i>{project.data.repository.archived ? "Archived upstream" : "Tracked upstream"}
        </span>
        <span>{project.data.source.provider}</span>
      </div>
      <h1>{project.data.name}</h1>
      <p class="lead">{project.data.summary}</p>
      <div class="project-category-line">
        {project.data.categories.map((category) => <a href={`/category/${category}`}>{categoryLabel(category)}</a>)}
      </div>
    </div>

    <div class="project-actions">
      {project.data.latestRelease.url && (
        <div class="project-action-group">
          <a class="button primary" href={project.data.latestRelease.url} target="_blank" rel="noopener noreferrer">Latest release ↗</a>
          <ReportBrokenLink
            label={`${project.data.name} latest release`}
            url={project.data.latestRelease.url}
            context="Project latest release"
            pageUrl={`/project/${project.data.slug}`}
            compact
          />
        </div>
      )}
      {sourceUrl && (
        <div class="project-action-group">
          <a class="button" href={sourceUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>
          <ReportBrokenLink
            label={`${project.data.name} source`}
            url={sourceUrl}
            context="Project source"
            pageUrl={`/project/${project.data.slug}`}
            compact
          />
        </div>
      )}
      {project.data.homepage && (
        <div class="project-action-group">
          <a class="button" href={project.data.homepage} target="_blank" rel="noopener noreferrer">Website ↗</a>
          <ReportBrokenLink
            label={`${project.data.name} website`}
            url={project.data.homepage}
            context="Project website"
            pageUrl={`/project/${project.data.slug}`}
            compact
          />
        </div>
      )}
    </div>
  </header>

  <div class="project-body">
    <div class="project-content">
      <section class="project-facts-strip" aria-label="Project facts">
        <div><span>Latest release</span><strong>{project.data.latestRelease.tag ?? "None tracked"}</strong></div>
        <div><span>Release date</span><strong>{formatDate(project.data.latestRelease.publishedAt)}</strong></div>
        <div><span>Source activity</span><strong>{formatDate(project.data.repository.lastCommit)}</strong></div>
        <div><span>PS2SP update</span><strong>{formatDate(updatedAt)}</strong></div>
      </section>

      <article class="prose project-prose" data-report-prose-links>
        <Content />
      </article>

      <script>
        const prose = document.querySelector<HTMLElement>("[data-report-prose-links]");
        if (prose) {
          const externalLinks = [...prose.querySelectorAll<HTMLAnchorElement>('a[href^="http://"], a[href^="https://"]')];
          for (const link of externalLinks) {
            if (link.classList.contains("report-broken-link")) continue;
            const targetUrl = link.href;
            const issueTitle = `Broken link: ${targetUrl}`;
            const issueBody = [
              "### Broken link report",
              "",
              `- Item: ${link.textContent?.trim() || targetUrl}`,
              `- URL: ${targetUrl}`,
              " - Context: Project documentation / writeup",
              `- PS2SP page: ${window.location.pathname}`,
              "",
              "The link appears to be broken, unavailable, or no longer points to the indexed PS2 resource."
            ].join("\\n");

            const report = document.createElement("a");
            report.className = "inline-link-report report-broken-link";
            report.href = `https://github.com/johnson-cooper/PS2SP/issues/new?title=${encodeURIComponent(issueTitle)}&body=${encodeURIComponent(issueBody)}`;
            report.target = "_blank";
            report.rel = "noopener noreferrer";
            report.textContent = "report";
            report.setAttribute("aria-label", `Report broken link: ${targetUrl}`);
            report.title = `Report broken link: ${targetUrl}`;
            link.insertAdjacentElement("afterend", report);
          }
        }
      </script>

      {project.data.features.length > 0 && (
        <section class="feature-section">
          <p class="eyebrow">Capabilities</p>
          <div class="feature-list">{project.data.features.map((feature) => <span>{feature}</span>)}</div>
        </section>
      )}
    </div>

    <aside class="project-sidebar">
      <div class="sidebar-block">
        <span class="sidebar-label">Repository</span>
        <dl>
          <div><dt>Provider</dt><dd>{project.data.source.provider}</dd></div>
          <div><dt>Stars</dt><dd>{project.data.repository.stars.toLocaleString()}</dd></div>
          <div><dt>Forks</dt><dd>{project.data.repository.forks.toLocaleString()}</dd></div>
          <div><dt>Branch</dt><dd>{project.data.repository.defaultBranch ?? "Unknown"}</dd></div>
          <div><dt>License</dt><dd>{project.data.license ?? "Unknown"}</dd></div>
        </dl>
      </div>

      <div class="sidebar-block">
        <span class="sidebar-label">Index record</span>
        <dl>
          <div><dt>Confidence</dt><dd>{project.data.discovery.confidence}%</dd></div>
          <div><dt>Discovery</dt><dd>{project.data.discovery.method}</dd></div>
          <div><dt>Verified</dt><dd>{project.data.verified ? "Yes" : "No"}</dd></div>
        </dl>
      </div>
    </aside>
  </div>
</BaseLayout>
