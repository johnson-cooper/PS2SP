---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getResourceGroups, getResources, resourceHost } from "../lib/resources";

const groups = getResourceGroups();
const resources = getResources();
const hosts = new Set(resources.map((resource) => resourceHost(resource.url))).size;
const ps2Symbols = ["△", "○", "×", "□"];
---

<BaseLayout title="PS2 Directory">
  <header class="page-hero compact">
    <div>
      <p class="eyebrow">The wider ecosystem</p>
      <h1>PS2 directory</h1>
      <p class="lead">Not everything important lives in a Git repository. Search deeply indexed PS2 documentation, communities, hardware references, compatibility data, archives, tools, game-specific resources and more.</p>
    </div>
    <div class="page-count"><strong>{resources.length}</strong><span>resources</span></div>
  </header>

  <section class="resource-browser" data-resource-browser>
    <aside class="resource-sidebar">
      <div class="resource-sidebar-head">
        <span>Directory sections</span>
        <small>{groups.length} groups · {hosts} hosts</small>
      </div>
      <button class="resource-nav active" type="button" data-resource-nav="">
        <span class="resource-nav-label"><span class="ps2-symbol" aria-hidden="true">◇</span><span>All resources</span></span>
        <strong>{resources.length}</strong>
      </button>
      {groups.map((group, index) => (
        <button class="resource-nav" type="button" data-resource-nav={group.category}>
          <span class="resource-nav-label">
            <span class="ps2-symbol" aria-hidden="true">{ps2Symbols[index % ps2Symbols.length]}</span>
            <span>{group.category}</span>
          </span>
          <strong>{group.links.length}</strong>
        </button>
      ))}
    </aside>

    <div class="resource-main">
      <label class="search-field resource-search">
        <span class="search-glyph" aria-hidden="true">⌕</span>
        <input data-resource-search type="search" placeholder="Search titles, serials, docs, categories, hosts…" autocomplete="off" />
        <kbd>/</kbd>
      </label>

      <div class="directory-summary">
        <strong data-resource-count>{resources.length}</strong>
        <span>resources match</span>
      </div>

      <div class="resource-index">
        <div class="resource-index-head" aria-hidden="true">
          <span>Resource</span>
          <span>Section</span>
          <span>Host</span>
        </div>
        <div data-resource-results aria-live="polite"></div>
      </div>

      <p class="empty directory-empty" data-resource-empty hidden>No resources match those filters.</p>
      <button class="resource-more" type="button" data-resource-more hidden>Load more results</button>
    </div>

    <script>
      interface ApiLink {
        name: string;
        url: string;
        keywords?: string[];
      }

      interface ApiGroup {
        category: string;
        description: string;
        links: ApiLink[];
      }

      interface SearchEntry extends ApiLink {
        category: string;
        categoryDescription: string;
        host: string;
        search: string;
      }

      const root = document.querySelector<HTMLElement>("[data-resource-browser]");
      if (root) {
        const search = root.querySelector<HTMLInputElement>("[data-resource-search]");
        const navs = [...root.querySelectorAll<HTMLButtonElement>("[data-resource-nav]")];
        const count = root.querySelector<HTMLElement>("[data-resource-count]");
        const empty = root.querySelector<HTMLElement>("[data-resource-empty]");
        const results = root.querySelector<HTMLElement>("[data-resource-results]");
        const more = root.querySelector<HTMLButtonElement>("[data-resource-more]");
        const symbols = ["△", "○", "×", "□"];
        const categorySymbols = new Map<string, string>();
        navs.slice(1).forEach((nav, index) => categorySymbols.set(nav.dataset.resourceNav ?? "", symbols[index % symbols.length]));

        let selected = new URL(window.location.href).searchParams.get("category") ?? "";
        let entries: SearchEntry[] = [];
        let visibleLimit = 250;

        function hostOf(value: string) {
          try {
            return new URL(value).hostname.replace(/^www\./, "");
          } catch {
            return "external resource";
          }
        }

        function makeRow(entry: SearchEntry) {
          const anchor = document.createElement("a");
          anchor.className = "resource-index-row";
          anchor.href = entry.url;
          anchor.target = "_blank";
          anchor.rel = "noopener noreferrer";

          const main = document.createElement("span");
          main.className = "resource-index-main";
          const strong = document.createElement("strong");
          strong.textContent = entry.name;
          const small = document.createElement("small");
          small.textContent = entry.categoryDescription;
          main.append(strong, small);

          const category = document.createElement("span");
          category.className = "resource-index-category";
          const symbol = document.createElement("span");
          symbol.className = "ps2-symbol";
          symbol.setAttribute("aria-hidden", "true");
          symbol.textContent = categorySymbols.get(entry.category) ?? "◇";
          const categoryName = document.createElement("span");
          categoryName.textContent = entry.category;
          category.append(symbol, categoryName);

          const host = document.createElement("span");
          host.className = "resource-index-host";
          host.append(document.createTextNode(entry.host + " "));
          const arrow = document.createElement("span");
          arrow.className = "row-arrow";
          arrow.textContent = "↗";
          host.append(arrow);

          anchor.append(main, category, host);
          return anchor;
        }

        function apply(resetLimit = true) {
          if (resetLimit) visibleLimit = 250;
          const query = search?.value.trim().toLowerCase() ?? "";
          const filtered = entries.filter((entry) => {
            const matchText = !query || entry.search.includes(query);
            const matchCategory = !selected || entry.category === selected;
            return matchText && matchCategory;
          });

          if (count) count.textContent = String(filtered.length);
          if (empty) empty.hidden = filtered.length !== 0;
          if (results) {
            results.replaceChildren(...filtered.slice(0, visibleLimit).map(makeRow));
          }
          if (more) {
            more.hidden = filtered.length <= visibleLimit;
            more.textContent = `Load more results (${Math.min(250, Math.max(0, filtered.length - visibleLimit))} next)`;
          }
          for (const nav of navs) nav.classList.toggle("active", (nav.dataset.resourceNav ?? "") === selected);
        }

        for (const nav of navs) {
          nav.addEventListener("click", () => {
            selected = nav.dataset.resourceNav ?? "";
            const url = new URL(window.location.href);
            if (selected) url.searchParams.set("category", selected);
            else url.searchParams.delete("category");
            history.replaceState({}, "", url);
            apply();
            root.querySelector(".resource-main")?.scrollIntoView({ behavior: "smooth", block: "start" });
          });
        }

        search?.addEventListener("input", () => apply());
        more?.addEventListener("click", () => {
          visibleLimit += 250;
          apply(false);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
          const target = event.target as HTMLElement | null;
          if (target?.matches("input, textarea, select, [contenteditable='true']")) return;
          event.preventDefault();
          search?.focus();
        });

        fetch("/api/resources.json")
          .then((response) => response.json())
          .then((payload: { groups: ApiGroup[] }) => {
            entries = payload.groups.flatMap((group) =>
              group.links.map((link) => {
                const host = hostOf(link.url);
                return {
                  ...link,
                  category: group.category,
                  categoryDescription: group.description,
                  host,
                  search: [link.name, group.category, host, ...(link.keywords ?? [])].join(" ").toLowerCase()
                };
              })
            );
            apply();
          })
          .catch(() => {
            if (empty) {
              empty.textContent = "The resource index could not be loaded.";
              empty.hidden = false;
            }
          });
      }
    </script>
  </section>
</BaseLayout>
