---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoryLabel, formatDate, getProjects, getSite, projectUpdatedAt } from "../lib/catalog";
import { getResourceGroups, getResources } from "../lib/resources";

const site = (await getSite()).data;
const projects = await getProjects();
const resourceGroups = getResourceGroups();
const resources = getResources();
const featured = projects.filter((project) => project.data.featured).slice(0, 6);
const recent = [...projects].sort((a, b) =>
  new Date(projectUpdatedAt(b)).getTime() - new Date(projectUpdatedAt(a)).getTime()
).slice(0, 6);

const categories = new Map<string, number>();
for (const project of projects) {
  for (const category of project.data.categories) {
    categories.set(category, (categories.get(category) ?? 0) + 1);
  }
}

const released = projects.filter((project) => project.data.latestRelease.tag).length;
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">PlayStation 2 ecosystem index</p>
    <h1>Software Plaza.</h1>
    <p class="lead">{site.tagline} PS2SP tracks software upstreams while also indexing the wider PS2 ecosystem: documentation, communities, hardware, mods, online services, preservation resources and more.</p>
    <div class="actions">
      <a class="button primary" href="/projects">Browse software</a>
      <a class="button" href="/resources">Browse all PS2 resources</a>
      <a class="button" href="/updates">Recent updates</a>
    </div>
  </section>

  <section class="stats" aria-label="Catalog statistics">
    <div class="stat"><strong>{projects.length}</strong><span>indexed software projects</span></div>
    <div class="stat"><strong>{resources.length}</strong><span>PS2 directory links</span></div>
    <div class="stat"><strong>{resourceGroups.length}</strong><span>ecosystem resource groups</span></div>
    <div class="stat"><strong>{released}</strong><span>projects with releases</span></div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><p class="eyebrow">Featured</p><h2>Core projects</h2></div>
      <a href="/projects">View all →</a>
    </div>
    <div class="grid">
      {featured.map((project) => (
        <a class="card" href={`/project/${project.data.slug}`}>
          <h3>{project.data.name}</h3>
          <p>{project.data.summary}</p>
          <div class="meta">
            {project.data.categories.slice(0, 2).map((category) => <span class="pill">{categoryLabel(category)}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><p class="eyebrow">Beyond repositories</p><h2>The whole PS2 ecosystem</h2></div>
      <a href="/resources">Open directory →</a>
    </div>
    <div class="resource-group-grid">
      {resourceGroups.map((group) => (
        <a class="resource-group" href={`/resources?category=${encodeURIComponent(group.category)}`}>
          <strong>{group.category}</strong>
          <span>{group.links.length} resources</span>
          <p>{group.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><p class="eyebrow">Activity</p><h2>Recently updated software</h2></div>
      <a href="/updates">All updates →</a>
    </div>
    <div class="grid">
      {recent.map((project) => (
        <a class="card" href={`/project/${project.data.slug}`}>
          <h3>{project.data.name}</h3>
          <p>{project.data.latestRelease.tag ? `Latest release: ${project.data.latestRelease.tag}` : "Tracking upstream development"}</p>
          <div class="meta"><span class="pill">{formatDate(projectUpdatedAt(project))}</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><div><p class="eyebrow">Explore software</p><h2>Categories</h2></div></div>
    <div class="category-list">
      {[...categories.entries()].sort((a, b) => b[1] - a[1]).map(([id, count]) => (
        <a class="category-link" href={`/category/${id}`}>{categoryLabel(id)} · {count}</a>
      ))}
    </div>
  </section>
</BaseLayout>
