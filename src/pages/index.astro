---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoryLabel, formatDate, getProjects, getSite, projectUpdatedAt } from "../lib/catalog";
import { getResourceGroups, getResources } from "../lib/resources";

const site = (await getSite()).data;
const projects = await getProjects();
const resourceGroups = getResourceGroups();
const resources = getResources();
const featured = projects.filter((project) => project.data.featured).slice(0, 5);
const recent = [...projects].sort((a, b) =>
  new Date(projectUpdatedAt(b)).getTime() - new Date(projectUpdatedAt(a)).getTime()
).slice(0, 5);

const categories = new Map<string, number>();
for (const project of projects) {
  for (const category of project.data.categories) {
    categories.set(category, (categories.get(category) ?? 0) + 1);
  }
}

const released = projects.filter((project) => project.data.latestRelease.tag).length;
---

<BaseLayout>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">PlayStation 2 ecosystem index</p>
      <h1><span>Software</span> Plaza.</h1>
      <p class="lead">{site.tagline}</p>

      <form class="hero-search" action="/projects" method="get">
        <span aria-hidden="true">⌕</span>
        <input name="q" type="search" placeholder="Find OPL, Neutrino, SDKs, save tools, emulators…" aria-label="Search software" />
        <button type="submit">Search</button>
      </form>

      <div class="hero-shortcuts">
        <a href="/projects">Software index <span>→</span></a>
        <a href="/resources">Full PS2 directory <span>→</span></a>
        <a href="/updates">Recent activity <span>→</span></a>
      </div>
    </div>

    <aside class="hero-console" aria-label="PS2SP catalog status">
      <div class="console-brand">
        <img
          class="hero-emblem"
          src="/brand/ps2sp-mark-glow.webp"
          width="700"
          height="659"
          alt=""
          aria-hidden="true"
        />
        <div class="console-brand-copy">
          <span class="console-label">PS2SP INDEX</span>
          <span class="live-indicator"><i></i> ONLINE</span>
        </div>
      </div>
      <dl class="console-stats">
        <div><dt>Software</dt><dd>{projects.length}</dd></div>
        <div><dt>Resources</dt><dd>{resources.length}</dd></div>
        <div><dt>Categories</dt><dd>{categories.size}</dd></div>
        <div><dt>Tracked releases</dt><dd>{released}</dd></div>
      </dl>
      <p>Repository activity and releases are synchronized upstream. The wider directory includes websites, archives, docs, communities, hardware resources and more.</p>
    </aside>
  </section>

  <section class="home-split section">
    <div class="home-panel">
      <div class="section-head">
        <div>
          <p class="eyebrow">Curated entry points</p>
          <h2>Featured software</h2>
        </div>
        <a href="/projects">All software →</a>
      </div>

      <div class="home-list">
        {featured.map((project, index) => (
          <a class="home-list-row" href={`/project/${project.data.slug}`}>
            <span class="list-index">{String(index + 1).padStart(2, "0")}</span>
            <span class="home-list-main">
              <strong>{project.data.name}</strong>
              <small>{project.data.summary}</small>
            </span>
            <span class="home-list-meta">{categoryLabel(project.data.categories[0] ?? "uncategorized")}</span>
            <span class="row-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>

    <div class="home-panel">
      <div class="section-head">
        <div>
          <p class="eyebrow">Upstream pulse</p>
          <h2>Recent activity</h2>
        </div>
        <a href="/updates">All updates →</a>
      </div>

      <div class="activity-stream">
        {recent.map((project) => (
          <a class="activity-row" href={`/project/${project.data.slug}`}>
            <span class="activity-date">{formatDate(projectUpdatedAt(project))}</span>
            <span class="activity-main">
              <strong>{project.data.name}</strong>
              <small>{project.data.latestRelease.tag ? `Release ${project.data.latestRelease.tag}` : "Repository activity"}</small>
            </span>
            <span class="row-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section ecosystem-section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Beyond repositories</p>
        <h2>Walk the wider plaza</h2>
      </div>
      <a href="/resources">{resources.length}+ resources →</a>
    </div>

    <div class="ecosystem-directory">
      {resourceGroups.map((group, index) => (
        <a class="ecosystem-row" href={`/resources?category=${encodeURIComponent(group.category)}`}>
          <span class="ecosystem-number">{String(index + 1).padStart(2, "0")}</span>
          <span class="ecosystem-title">
            <strong>{group.category}</strong>
            <small>{group.description}</small>
          </span>
          <span class="ecosystem-count">{group.links.length}</span>
          <span class="row-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section category-strip-section">
    <div class="section-head">
      <div><p class="eyebrow">Software map</p><h2>Browse by function</h2></div>
    </div>
    <div class="category-strip">
      {[...categories.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12).map(([id, count]) => (
        <a href={`/category/${id}`}>
          <strong>{categoryLabel(id)}</strong>
          <span>{count}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
