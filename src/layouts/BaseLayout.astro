---
import "../styles/global.css";
import { getSite } from "../lib/catalog";

interface Props {
  title?: string;
  description?: string;
}

const siteEntry = await getSite();
const site = siteEntry.data;
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — ${site.longTitle}`;
const path = Astro.url.pathname;

const navItems = [
  { href: "/projects", label: "Software", match: ["/projects", "/project/", "/category/"] },
  { href: "/resources", label: "Directory", match: ["/resources"] },
  { href: "/updates", label: "Updates", match: ["/updates"] },
  { href: "/about", label: "About", match: ["/about"] }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050816" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="256x256" href="/brand/ps2sp-mark.png" />
    <link rel="apple-touch-icon" href="/brand/ps2sp-mark.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="plaza-backdrop" aria-hidden="true">
      <div class="plaza-orbit plaza-orbit-a"></div>
      <div class="plaza-orbit plaza-orbit-b"></div>
      <div class="plaza-axis"></div>
    </div>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="PS2SP — PlayStation 2 Software Plaza home">
          <img
            class="brand-wordmark"
            src="/brand/ps2sp-wordmark.webp"
            width="768"
            height="256"
            alt="PS2SP — PlayStation 2 Software Plaza"
          />
          <img
            class="brand-mark-mobile"
            src="/brand/ps2sp-mark.png"
            width="256"
            height="256"
            alt=""
            aria-hidden="true"
          />
        </a>

        <nav class="primary-nav" aria-label="Primary">
          {navItems.map((item) => {
            const active = item.match.some((prefix) => path === prefix || path.startsWith(prefix));
            return <a class:list={["nav-link", { active }]} href={item.href} aria-current={active ? "page" : undefined}>{item.label}</a>;
          })}
        </nav>

        <div class="header-actions">
          <a class="header-search" href="/projects" aria-label="Search PS2SP">
            <span>Search</span><kbd>/</kbd>
          </a>
          <a class="source-link" href={site.repository} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
    </header>

    <div class="context-bar">
      <div class="context-inner">
        <span class="live-indicator"><i></i> live index</span>
        <span class="context-path">PS2SP{path === "/" ? " / plaza" : path.replaceAll("/", " / ")}</span>
      </div>
    </div>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-brand">
          <strong>PS2SP</strong>
          <p>Independent community index for PlayStation 2 software and ecosystem resources.</p>
          <div class="footer-credit" aria-label="Project credits">
            <span class="credit-label">Credits</span>
            <a href="https://github.com/johnson-cooper" target="_blank" rel="noopener noreferrer">
              <span class="ps2-symbol" aria-hidden="true">△</span>
              <span><strong>johnson-cooper</strong><small>repository owner</small></span>
            </a>
            <a href="https://github.com/NathanNeurotic" target="_blank" rel="noopener noreferrer">
              <span class="ps2-symbol" aria-hidden="true">□</span>
              <span><strong>NathanNeurotic</strong><small>direction &amp; curation</small></span>
            </a>
          </div>
        </div>
        <div class="footer-links">
          <a href="/projects">Software</a>
          <a href="/resources">Directory</a>
          <a href="/updates">Updates</a>
          <a href={site.repository}>Source</a>
        </div>
        <p class="legal">Not affiliated with or endorsed by Sony Interactive Entertainment. PlayStation and related marks belong to their respective owners.</p>
      </div>
    </footer>
  </body>
</html>
