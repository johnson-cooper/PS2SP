---
import "../styles/global.css";
import { getSite } from "../lib/catalog";

interface Props {
  title?: string;
  description?: string;
}

const siteEntry = await getSite();
const site = siteEntry.data;
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — ${site.longTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050b24" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark">PS2</span>
        <span>
          <strong>{site.title}</strong>
          <small>{site.longTitle}</small>
        </span>
      </a>
      <nav aria-label="Primary">
        <a href="/projects">Software</a>
        <a href="/resources">PS2 Directory</a>
        <a href="/updates">Updates</a>
        <a href="/about">About</a>
        <a href={site.repository}>GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>{site.longTitle}. Software metadata is tracked alongside a broader directory of PlayStation 2 resources and upstream sources.</p>
    </footer>
  </body>
</html>
