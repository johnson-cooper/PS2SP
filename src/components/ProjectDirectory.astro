---
import { categoryLabel } from "../lib/catalog";
import type { SoftwareCatalogEntry } from "../lib/software";

interface Props {
  entries: SoftwareCatalogEntry[];
  showCategoryFilter?: boolean;
  heading?: string;
  description?: string;
  scopeCategory?: string;
}

const {
  entries,
  showCategoryFilter = true,
  heading,
  description,
  scopeCategory = ""
} = Astro.props;

const categories = [...new Set(entries.flatMap((entry) => entry.categories))].sort((a, b) =>
  categoryLabel(a).localeCompare(categoryLabel(b))
);
const ps2Symbols = ["△", "○", "×", "□"];
const categorySymbols = new Map(categories.map((category, index) => [category, ps2Symbols[index % ps2Symbols.length]]));

const genericTags = new Set([
  "ps2",
  "playstation 2",
  "playstation2",
  "auto-discovered",
  "resource-index",
  "pending-promoted"
]);

const tagCounts = new Map<string, { label: string; count: number }>();
for (const entry of entries) {
  for (const rawTag of entry.tags) {
    const label = String(rawTag).trim();
    const key = label.toLowerCase();
    if (!label || genericTags.has(key) || label.length > 42) continue;
    const current = tagCounts.get(key);
    tagCounts.set(key, { label: current?.label ?? label, count: (current?.count ?? 0) + 1 });
  }
}
const tags = [...tagCounts.entries()]
  .sort((a, b) => b[1].count - a[1].count || a[1].label.localeCompare(b[1].label))
  .slice(0, 180);
const quickTags = tags.slice(0, 14);
const categorySymbolData = Object.fromEntries(categorySymbols);
---

<section
  class="directory-shell"
  data-project-directory
  data-project-scope-category={scopeCategory}
  data-category-symbols={JSON.stringify(categorySymbolData)}
>
  {(heading || description) && (
    <div class="directory-intro">
      {heading && <h2>{heading}</h2>}
      {description && <p>{description}</p>}
    </div>
  )}

  <div class="directory-toolbar directory-toolbar-rich">
    <label class="search-field">
      <span class="search-glyph" aria-hidden="true">⌕</span>
      <input
        data-project-search
        type="search"
        placeholder="Search software, tags, forks, features…"
        autocomplete="off"
        aria-label="Search software"
      />
      <kbd>/</kbd>
    </label>

    {showCategoryFilter && (
      <label class="select-field">
        <span>Category</span>
        <select data-project-category>
          <option value="">All categories</option>
          {categories.map((category) => <option value={category}>{categorySymbols.get(category)} {categoryLabel(category)}</option>)}
        </select>
      </label>
    )}

    <label class="select-field">
      <span>Tag</span>
      <select data-project-tag>
        <option value="">All tags</option>
        {tags.map(([key, tag]) => <option value={key}>{tag.label} ({tag.count})</option>)}
      </select>
    </label>

    <label class="select-field">
      <span>Source</span>
      <select data-project-source>
        <option value="">All sources</option>
        <option value="tracked">Tracked GitHub</option>
        <option value="external">External / legacy</option>
        <option value="fork">Forks</option>
        <option value="archived">Archived</option>
      </select>
    </label>

    <label class="select-field">
      <span>Sort</span>
      <select data-project-sort>
        <option value="updated">Recent activity</option>
        <option value="name">A–Z</option>
        <option value="name-desc">Z–A</option>
        <option value="category">Category</option>
      </select>
    </label>

    <button class="filter-clear" type="button" data-project-clear>Clear</button>
  </div>

  {quickTags.length > 0 && (
    <div class="quick-filter-strip" aria-label="Popular software tags">
      <span class="quick-filter-label">Popular tags</span>
      <div class="quick-filter-list">
        {quickTags.map(([key, tag]) => (
          <button type="button" class="filter-chip" data-project-quick-tag={key}>
            <span>{tag.label}</span><strong>{tag.count}</strong>
          </button>
        ))}
      </div>
    </div>
  )}

  <div class="directory-summary directory-summary-rich" aria-live="polite">
    <div><strong data-project-count>{entries.length}</strong><span> software entries shown</span></div>
    <small data-project-filter-state>{scopeCategory ? categoryLabel(scopeCategory) : "All software"}</small>
  </div>

  <div class="project-index">
    <div class="project-index-head" aria-hidden="true">
      <span>#</span>
      <span>Software</span>
      <span>Type</span>
      <span>Release</span>
      <span>Activity</span>
    </div>
    <div data-project-results aria-live="polite"></div>
  </div>

  <p class="directory-loading" data-project-loading>Loading software index…</p>
  <p class="empty directory-empty" data-project-empty hidden>No software entries match those filters.</p>
  <button class="resource-more" type="button" data-project-more hidden>Load more software</button>

  <script>
    interface SoftwareEntry {
      name: string;
      summary: string;
      categories: string[];
      tags: string[];
      features: string[];
      href: string;
      external: boolean;
      archived: boolean;
      releaseTag: string | null;
      updatedAt: string | null;
      sourceKind: "project" | "resource";
    }

    const roots = document.querySelectorAll<HTMLElement>("[data-project-directory]");

    for (const root of roots) {
      const search = root.querySelector<HTMLInputElement>("[data-project-search]");
      const category = root.querySelector<HTMLSelectElement>("[data-project-category]");
      const tag = root.querySelector<HTMLSelectElement>("[data-project-tag]");
      const source = root.querySelector<HTMLSelectElement>("[data-project-source]");
      const sort = root.querySelector<HTMLSelectElement>("[data-project-sort]");
      const clear = root.querySelector<HTMLButtonElement>("[data-project-clear]");
      const quickTags = [...root.querySelectorAll<HTMLButtonElement>("[data-project-quick-tag]")];
      const results = root.querySelector<HTMLElement>("[data-project-results]");
      const count = root.querySelector<HTMLElement>("[data-project-count]");
      const state = root.querySelector<HTMLElement>("[data-project-filter-state]");
      const empty = root.querySelector<HTMLElement>("[data-project-empty]");
      const loading = root.querySelector<HTMLElement>("[data-project-loading]");
      const more = root.querySelector<HTMLButtonElement>("[data-project-more]");
      const scopeCategory = root.dataset.projectScopeCategory ?? "";
      let categorySymbols: Record<string, string> = {};
      try {
        categorySymbols = JSON.parse(root.dataset.categorySymbols ?? "{}");
      } catch {
        categorySymbols = {};
      }

      let entries: SoftwareEntry[] = [];
      let visibleLimit = 300;

      const url = new URL(window.location.href);
      if (search) search.value = url.searchParams.get("q") ?? "";
      if (category) category.value = url.searchParams.get("category") ?? "";
      if (tag) tag.value = url.searchParams.get("tag") ?? "";
      if (source) source.value = url.searchParams.get("source") ?? "";
      if (sort) sort.value = url.searchParams.get("sort") ?? "updated";

      function formatDate(value: string | null) {
        if (!value) return "Indexed";
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return "Indexed";
        return new Intl.DateTimeFormat("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric"
        }).format(date);
      }

      function categoryLabelClient(value: string) {
        return value
          .split("-")
          .map((part) => part ? part[0].toUpperCase() + part.slice(1) : part)
          .join(" ")
          .replace(/^Sdks$/, "SDKs");
      }

      function visibleTags(entry: SoftwareEntry) {
        const generic = new Set([
          "ps2",
          "playstation 2",
          "playstation2",
          "auto-discovered",
          "resource-index",
          "pending-promoted"
        ]);
        return entry.tags
          .map((value) => String(value).trim())
          .filter((value) => value && !generic.has(value.toLowerCase()) && value.length <= 30)
          .filter((value, index, all) => all.findIndex((other) => other.toLowerCase() === value.toLowerCase()) === index)
          .slice(0, 4);
      }

      function sourceMatches(entry: SoftwareEntry, selected: string) {
        if (!selected) return true;
        const tagKeys = entry.tags.map((value) => String(value).trim().toLowerCase());
        if (selected === "tracked") return entry.sourceKind === "project";
        if (selected === "external") return entry.sourceKind === "resource";
        if (selected === "fork") return tagKeys.includes("fork");
        if (selected === "archived") return entry.archived;
        return true;
      }

      function makeRow(entry: SoftwareEntry, index: number) {
        const tagKeys = entry.tags.map((value) => String(value).trim().toLowerCase());
        const isFork = tagKeys.includes("fork");
        const primaryCategory = entry.categories[0] ?? "uncategorized";

        const anchor = document.createElement("a");
        anchor.className = "project-index-row";
        anchor.href = entry.href;
        if (entry.external) {
          anchor.target = "_blank";
          anchor.rel = "noopener noreferrer";
        }

        const number = document.createElement("span");
        number.className = "project-index-number";
        number.textContent = String(index + 1).padStart(3, "0");

        const main = document.createElement("span");
        main.className = "project-index-main";
        const name = document.createElement("strong");
        name.textContent = entry.name;
        const summary = document.createElement("span");
        summary.textContent = entry.summary;
        main.append(name, summary);

        const rowTags = visibleTags(entry);
        if (rowTags.length) {
          const tags = document.createElement("span");
          tags.className = "row-tag-list";
          tags.setAttribute("aria-label", "Tags");
          for (const value of rowTags) {
            const chip = document.createElement("span");
            chip.className = "row-tag";
            chip.textContent = value;
            tags.append(chip);
          }
          main.append(tags);
        }

        const type = document.createElement("span");
        type.className = "project-index-type";
        const dot = document.createElement("span");
        dot.className = "status-dot";
        dot.dataset.state = entry.archived ? "archived" : entry.sourceKind === "resource" ? "external" : isFork ? "fork" : "tracked";
        const badge = document.createElement("span");
        badge.className = "category-badge";
        const symbol = document.createElement("span");
        symbol.className = "ps2-symbol";
        symbol.setAttribute("aria-hidden", "true");
        symbol.textContent = categorySymbols[primaryCategory] ?? "◇";
        const categoryName = document.createElement("span");
        categoryName.textContent = categoryLabelClient(primaryCategory);
        badge.append(symbol, categoryName);
        type.append(dot, badge);

        const release = document.createElement("span");
        release.className = "project-index-release";
        release.textContent = isFork ? "fork" : entry.releaseTag ?? (entry.sourceKind === "resource" ? "external" : "—");

        const activity = document.createElement("span");
        activity.className = "project-index-activity";
        const time = document.createElement("time");
        if (entry.updatedAt) time.dateTime = entry.updatedAt;
        time.textContent = formatDate(entry.updatedAt);
        const arrow = document.createElement("span");
        arrow.className = "row-arrow";
        arrow.setAttribute("aria-hidden", "true");
        arrow.textContent = entry.external ? "↗" : "→";
        activity.append(time, arrow);

        anchor.append(number, main, type, release, activity);
        return anchor;
      }

      function syncUrl() {
        const next = new URL(window.location.href);
        const values: Array<[string, string]> = [
          ["q", search?.value.trim() ?? ""],
          ["category", category?.value ?? ""],
          ["tag", tag?.value ?? ""],
          ["source", source?.value ?? ""],
          ["sort", sort?.value && sort.value !== "updated" ? sort.value : ""]
        ];
        for (const [key, value] of values) {
          if (value) next.searchParams.set(key, value);
          else next.searchParams.delete(key);
        }
        history.replaceState({}, "", next);
      }

      function apply(resetLimit = true) {
        if (resetLimit) visibleLimit = 300;

        const query = search?.value.trim().toLowerCase() ?? "";
        const selectedCategory = category?.value ?? "";
        const selectedTag = tag?.value ?? "";
        const selectedSource = source?.value ?? "";

        const filtered = entries.filter((entry) => {
          if (scopeCategory && !entry.categories.includes(scopeCategory)) return false;
          if (selectedCategory && !entry.categories.includes(selectedCategory)) return false;
          if (selectedTag && !entry.tags.some((value) => String(value).trim().toLowerCase() === selectedTag)) return false;
          if (!sourceMatches(entry, selectedSource)) return false;
          if (!query) return true;

          const isFork = entry.tags.some((value) => String(value).trim().toLowerCase() === "fork");
          const haystack = [
            entry.name,
            entry.summary,
            ...entry.tags,
            ...entry.features,
            ...entry.categories,
            isFork ? "fork" : "",
            entry.sourceKind === "resource" ? "external legacy" : "github tracked"
          ].join(" ").toLowerCase();
          return haystack.includes(query);
        });

        const mode = sort?.value ?? "updated";
        filtered.sort((a, b) => {
          if (mode === "updated") {
            const delta = new Date(b.updatedAt ?? 0).getTime() - new Date(a.updatedAt ?? 0).getTime();
            if (delta) return delta;
          }
          if (mode === "name-desc") return b.name.localeCompare(a.name);
          if (mode === "category") {
            const delta = (a.categories[0] ?? "").localeCompare(b.categories[0] ?? "");
            if (delta) return delta;
          }
          return a.name.localeCompare(b.name);
        });

        if (count) count.textContent = String(filtered.length);
        if (empty) empty.hidden = filtered.length !== 0;
        if (results) {
          results.replaceChildren(...filtered.slice(0, visibleLimit).map((entry, index) => makeRow(entry, index)));
        }
        if (more) {
          more.hidden = filtered.length <= visibleLimit;
          more.textContent = `Load more software (${Math.min(300, Math.max(0, filtered.length - visibleLimit))} next)`;
        }

        const active: string[] = [];
        if (query) active.push(`search “${search?.value.trim()}”`);
        if (scopeCategory) active.push(categoryLabelClient(scopeCategory));
        if (selectedCategory && category) active.push(category.options[category.selectedIndex]?.text.replace(/^[△○×□]\s*/, "") ?? selectedCategory);
        if (selectedTag && tag) active.push(`tag: ${tag.options[tag.selectedIndex]?.text.replace(/\s+\(\d+\)$/, "") ?? selectedTag}`);
        if (selectedSource && source) active.push(source.options[source.selectedIndex]?.text ?? selectedSource);
        if (state) state.textContent = active.length ? active.join(" · ") : "All software";

        for (const chip of quickTags) {
          chip.classList.toggle("active", (chip.dataset.projectQuickTag ?? "") === selectedTag);
        }

        syncUrl();
      }

      function clearFilters() {
        if (search) search.value = "";
        if (category) category.value = "";
        if (tag) tag.value = "";
        if (source) source.value = "";
        if (sort) sort.value = "updated";
        apply();
      }

      search?.addEventListener("input", () => apply());
      category?.addEventListener("change", () => apply());
      tag?.addEventListener("change", () => apply());
      source?.addEventListener("change", () => apply());
      sort?.addEventListener("change", () => apply());
      clear?.addEventListener("click", clearFilters);
      more?.addEventListener("click", () => {
        visibleLimit += 300;
        apply(false);
      });

      for (const chip of quickTags) {
        chip.addEventListener("click", () => {
          if (!tag) return;
          const value = chip.dataset.projectQuickTag ?? "";
          tag.value = tag.value === value ? "" : value;
          apply();
        });
      }

      document.addEventListener("keydown", (event) => {
        if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
        const target = event.target as HTMLElement | null;
        if (target?.matches("input, textarea, select, [contenteditable='true']")) return;
        event.preventDefault();
        search?.focus();
      });

      fetch("/api/software.json")
        .then((response) => {
          if (!response.ok) throw new Error(`Software index request failed: ${response.status}`);
          return response.json();
        })
        .then((payload: { entries: SoftwareEntry[] }) => {
          entries = payload.entries;
          if (loading) loading.hidden = true;
          apply();
        })
        .catch(() => {
          if (loading) {
            loading.textContent = "The software index could not be loaded.";
          }
          if (count) count.textContent = "0";
        });
    }
  </script>
</section>
